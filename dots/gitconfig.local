# Shared git settings (symlinked to ~/.gitconfig.local, included from ~/.gitconfig).
# Personal identity (user.name, user.email, signingkey) lives only in ~/.gitconfig
# via bootstrap — do not put those here.

[core]
  excludesfile = ~/.gitignore
[alias]
  # Other useful aliases:
  co = checkout
  st = status

  unstage = reset HEAD
  staged = diff --cached
  unstaged = diff
  current-branch = !git symbolic-ref -q HEAD | sed -e 's|^refs/heads/||'
  head = !git l -1

  # Usage: git track origin/feature-123-login-form
  track = checkout -t
  # info shows information about your remote repo
  info = remote show

  # remove branches no longer on remote that have been merged - using https://stackoverflow.com/a/38404202
  clean-branches = !git fetch -p && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 ~ /gone/ {print $1}' | xargs -n 1 git branch -d

[apply]
  whitespace = warn
[color]
  diff = auto
  status = auto
  branch = auto
  ui = true
[help]
  autocorrect = 1
[status]
  submodule = 1
[push]
  # Only push branches that have been set up to track a remote branch.
  default = upstream
  autoSetupRemote = true
[pull]
  # Only push branches that have been set up to track a remote branch.
  default = current
[merge]
  tool = vimdiff
  stat = true # show a diffstat at the end of a merge
[diff]
  tool = vimdiff
[difftool]
  prompt = false

# if you want to load a custom gitconfig for a specific repo
#[includeIf "gitdir:~/code/some-git-repo/**"]
#path = ~/code/some-git-repo/.gitconfig-custom-config
